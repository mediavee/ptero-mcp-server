# Bearer token required by Claude clients to talk to this MCP server.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# HTTP bind address and port
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Console hub tuning
# Rolling buffer size per (panel, key, server) session. Bump on chatty
# servers (packed survival, logging-heavy plugins) where 5000 lines still
# represents only a few seconds of output.
CONSOLE_BUFFER_SIZE=5000
# TTL in seconds after the last access before an unwatched session's WS is closed
CONSOLE_IDLE_TTL=600

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# NOTE: the panel URL and Client API key are NOT configured here. They are
# provided per-request by the MCP client through the X-Pterodactyl-Url and
# X-Pterodactyl-Key HTTP headers so a single instance can serve any number
# of panels and operator keys (one isolated buffer per panel + key + server
# triple). Configure your URL and key(s) on the client side (see README —
# Multi-panel usage).
