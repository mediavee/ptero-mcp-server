# Pterodactyl panel URL (no trailing slash)
PTERODACTYL_URL=https://panel.example.com

# Pterodactyl Client API key (generated in the panel at Account > API Credentials)
PTERODACTYL_API_KEY=ptlc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bearer token required by Claude clients to talk to this MCP server.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# HTTP bind address and port
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Console hub tuning
# Rolling buffer size per watched server (lines). Bump this on chatty servers
# (packed survival, logging-heavy plugins) where 5000 lines still represents
# only a few seconds of output.
CONSOLE_BUFFER_SIZE=5000
# TTL in seconds after the last access before an unwatched server's WS is closed
CONSOLE_IDLE_TTL=600
