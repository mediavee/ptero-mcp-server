# Pterodactyl panel URL (without trailing slash) and a Client API key.
# Generate the key at: https://<panel>/account/api
PTERODACTYL_URL=https://panel.example.com
PTERODACTYL_KEY=

# Console hub tuning
# Rolling buffer size per server session. Bump on chatty servers (packed
# survival, logging-heavy plugins) where 5000 lines still represents only
# a few seconds of output.
CONSOLE_BUFFER_SIZE=5000
# TTL in seconds after the last access before an unwatched session's WS is closed
CONSOLE_IDLE_TTL=600

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
